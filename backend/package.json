{
  "name": "social-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Social — Node.js + Express + PostgreSQL API (Phase 2)",
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
