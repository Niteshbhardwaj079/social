# Copy to .env (or set these as real environment variables on your host). Nothing else needs editing:
# the same code runs on a laptop, a VPS, Docker, or any cloud that can run Node.js + PostgreSQL.

# ---- Required -------------------------------------------------------------------------------
# Any PostgreSQL 13+ server. The database MUST be UTF8:  CREATE DATABASE social ENCODING 'UTF8' TEMPLATE template0;
DATABASE_URL=postgres://social:change-me@localhost:5432/social
# 32+ random characters. Generate one:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# ---- Where the app lives ---------------------------------------------------------------------
NODE_ENV=production
PORT=4000
# The public address of the app: used in the links inside emails (reset password, invitations).
APP_URL=https://social.your-client.com
# Set to true when the site is served over https (turns on secure cookies + HSTS).
COOKIE_SECURE=true
# Behind nginx / a load balancer / a platform proxy, set this so client IPs and rate limits are right:
# 1 = one proxy in front, true = trust all, false = none.
TRUST_PROXY=1

# ---- Optional ---------------------------------------------------------------------------------
# Only when the web app is hosted on a DIFFERENT domain than this API (comma separated).
CORS_ORIGINS=
# Serve the built front-end (../dist) from this same server. Turn off if the front-end is hosted elsewhere.
SERVE_FRONTEND=true
# Run database migrations automatically on start. Set false to run "npm run migrate" yourself.
AUTO_MIGRATE=true
DATABASE_SSL=false
DATABASE_POOL_MAX=10
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=30
# Failed sign-ins / resets allowed per IP per 15 minutes.
RATE_LIMIT_MAX=20
LOG_LEVEL=info

# ---- Social platforms (the client brings their own API keys; nothing here costs money) ----------------
# Encrypts the platform keys/tokens saved in the database. Leave empty and a key is derived from JWT_SECRET.
# Whichever you use, keep it stable: if it changes, saved keys cannot be read and accounts must be connected again.
# Generate one:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=
# Re-check connected accounts in the background this often (minutes). 0 = never.
SOCIAL_CHECK_INTERVAL_MIN=360
# Give up on a platform that does not answer within this many seconds.
PROVIDER_TIMEOUT_SEC=15
# Most test / connect / sync calls per minute per IP (each one calls a platform).
PROVIDER_RATE_LIMIT_PER_MIN=30
# Facebook retires old Graph API versions after ~2 years. Bump this instead of editing code.
META_GRAPH_VERSION=v24.0

# ---- Scheduler (posts scheduled for later) -----------------------------------------------------------
# How often to look for posts whose time has come (seconds). 0 = scheduler off (nothing is sent on its own).
SCHEDULER_INTERVAL_SEC=30
# A scheduled post this many minutes late (the server was off) is NOT sent; it is marked failed so nobody is surprised.
SCHEDULER_GRACE_MIN=60

# ---- Content recycling (auto-reposting) -----------------------------------------------------------------
# How often to check the recycling queue for a repost whose time has come (minutes). 0 = off.
RECYCLING_INTERVAL_MIN=30

# ---- Analytics (real per-post engagement) ----------------------------------------------------------------
# How often to re-fetch real likes/comments/shares/views for published posts, from the platforms whose API
# supports it (minutes). 0 = off.
ANALYTICS_REFRESH_INTERVAL_MIN=120
# How often to poll connected accounts for new comments on published posts (minutes). 0 = off.
INBOX_REFRESH_INTERVAL_MIN=30

# ---- Media & storage -----------------------------------------------------------------------------------
# "Server" storage (the default, no account needed): uploaded files are saved to this folder on disk.
MEDIA_LOCAL_DIR=data/media
# The largest single file an upload accepts (MB). Well above this and multer refuses it before it is saved.
MEDIA_MAX_UPLOAD_MB=200
# External storage (Amazon S3, Cloudflare R2, Backblaze B2, Wasabi, DigitalOcean Spaces, other S3-compatible,
# or Google Drive) is connected from inside the app (Settings → Storage) — nothing to set here for that.
# It reuses ENCRYPTION_KEY above to encrypt the saved keys, and PROVIDER_TIMEOUT_SEC / PROVIDER_RATE_LIMIT_PER_MIN.

# ---- Email (bring your own SMTP: your mailbox, Zoho, Brevo, Amazon SES SMTP, Postfix... any). --------
# Leave SMTP_HOST empty and emails are only recorded in the email_outbox table (nothing is sent).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Social <no-reply@your-client.com>

# ---- Brand shown inside emails -----------------------------------------------------------------
BRAND_APP_NAME=Social
BRAND_COMPANY=Gowebkart Pvt Ltd
BRAND_SUPPORT_EMAIL=support@gowebkart.in
BRAND_WEBSITE_URL=https://gowebkart.in
