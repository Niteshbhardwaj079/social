{
  "mail": {
    "help": "Need help? Write to",
    "auto": "This is an automated message from {{app_name}} — please do not reply to this email.",
    "passwordReset": {
      "s": "Reset your {{app_name}} password",
      "h": "Reset your password",
      "b": [
        "Hi {{user_name}}, we received a request to reset your password.",
        "[Click here to choose a new password]({{reset_link}}) — this link expires in {{expires_in}}.",
        "If you didn't request this, you can safely ignore this email."
      ]
    },
    "passwordChanged": {
      "s": "Your {{app_name}} password was changed",
      "h": "Your password was changed",
      "b": [
        "Hi {{user_name}}, your password was changed on {{changed_at}}.",
        "If this wasn't you, contact {{support_email}} immediately."
      ]
    },
    "newSignIn": {
      "s": "New sign-in to your {{app_name}} account",
      "h": "New sign-in detected",
      "b": [
        "Hi {{user_name}}, we noticed a new sign-in from {{device}} in {{location}} on {{signed_in_at}}.",
        "If this was you, no action is needed. If not, change your password right away."
      ]
    },
    "invited": {
      "s": "You've been invited to {{company}} on {{app_name}}",
      "h": "You have been invited",
      "b": [
        "{{invited_by}} invited you to join {{company}} on {{app_name}} as {{role}}.",
        "[Accept the invitation]({{accept_link}}) to get started."
      ]
    },
    "userAdded": {
      "s": "{{new_user_name}} was added to {{company}}",
      "h": "A new user was added",
      "b": [
        "{{added_by}} added {{new_user_name}} ({{new_user_email}}) as {{role}}.",
        "[Review users & roles]({{users_url}})"
      ]
    },
    "roleChanged": {
      "s": "Your role on {{app_name}} was updated",
      "h": "Your role was updated",
      "b": [
        "Hi {{user_name}}, {{changed_by}} changed your role from {{old_role}} to {{new_role}}."
      ]
    },
    "accountConnected": {
      "s": "{{provider}} account {{account_name}} was connected",
      "h": "A social account was connected",
      "b": [
        "{{connected_by}} connected {{account_name}} ({{provider}}) on {{connected_at}}.",
        "[View social accounts]({{accounts_url}})"
      ]
    },
    "tokenExpired": {
      "s": "Reconnect your {{provider}} account",
      "h": "Your connection needs attention",
      "b": [
        "{{account_name}} ({{provider}}) needs to be reconnected before {{app_name}} can keep posting to it.",
        "[Reconnect now]({{accounts_url}})"
      ]
    },
    "postPublished": {
      "s": "Your post was published",
      "h": "Your post is live",
      "b": [
        "\"{{post_excerpt}}\" was published to {{platforms}} on {{published_at}}."
      ]
    },
    "postFailed": {
      "s": "A post failed to publish",
      "h": "A post failed to publish",
      "b": [
        "\"{{post_excerpt}}\" could not be published to {{platforms}}: {{error_reason}}.",
        "[Review and retry]({{posts_url}})"
      ]
    },
    "approvalRequested": {
      "s": "{{submitted_by}} submitted a post for approval",
      "h": "A post needs your review",
      "b": [
        "{{submitted_by}} submitted \"{{post_excerpt}}\" for approval.",
        "[Review it now]({{approvals_url}})"
      ]
    },
    "approvalDecided": {
      "s": "Your post was {{decision}}",
      "h": "A decision was made on your post",
      "b": [
        "{{reviewer}} {{decision}} \"{{post_excerpt}}\".",
        "{{reason}}"
      ]
    },
    "newComment": {
      "s": "New comment from {{commenter_name}}",
      "h": "You have a new comment",
      "b": [
        "{{commenter_name}} commented on \"{{post_excerpt}}\": “{{comment_text}}”",
        "[Reply in Inbox]({{inbox_url}})"
      ]
    }
  },
  "roles": {
    "superAdmin": "Super Admin",
    "admin": "Admin",
    "editor": "Editor",
    "contributor": "Contributor",
    "analyst": "Analyst"
  }
}
