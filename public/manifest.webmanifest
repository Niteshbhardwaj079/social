{
  "name": "Social by Gowebkart",
  "short_name": "Social",
  "description": "One dashboard for every social channel: posts, AI, inbox, analytics, ads and billing.",
  "id": "/",
  "start_url": "/dashboard",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "orientation": "any",
  "background_color": "#f5f6fa",
  "theme_color": "#2563eb",
  "categories": ["business", "productivity", "social"],
  "icons": [
    { "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Create post", "url": "/posts/create", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Calendar", "url": "/calendar", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Inbox", "url": "/inbox", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "AI Studio", "url": "/ai", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
